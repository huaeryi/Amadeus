# Copy this file to .env for local use.
# Do not commit real cookies, tokens, sessions, or Authorization headers.

# NSSCTF fetch helper:
# NSSCTF_COOKIE='session=...'

# BUUCTF/BUUOJ fetch helper:
# BUUCTF_COOKIE='session=...'
# BUUOJ_COOKIE='session=...'

# Optional token-style auth, if a platform/account exposes one:
# BUUCTF_TOKEN='...'
# BUUOJ_TOKEN='...'
