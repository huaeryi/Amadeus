#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
usage: amds [--print] [--dry-run] [--runner codex|claude|--codex|--claude] [--policy strict|aggressive|none] [--group NAME] [--append TEXT] [--mode solve|guide|pre|audit|fetch|exec|learn] [--workflow NAME|--pwn|--web|--crypto|--misc|--reverse|--x402] [--session ID|latest] <challenge|path|url> [-- agent_args...]

examples:
  amds --mode solve --workflow pwn newnote
  amds --runner claude --mode solve --workflow pwn newnote
  amds --claude audit audit_target
  amds --mode guide --workflow pwn newnote
  amds --mode pre --workflow pwn newnote
  amds pre pwn newnote
  amds --mode audit --workflow x402 audit_target
  amds --runner claude audit audit_target
  amds --mode fetch https://www.nssctf.cn/problem/131
  amds fetch --group defcon https://www.nssctf.cn/problem/131
  amds --mode exec https://www.nssctf.cn/problem/131
  amds --mode exec --workflow pwn https://www.nssctf.cn/problem/131
  amds --mode learn newnote
  amds learn newnote --session latest
  amds learn newnote --session 20260522-143012-pwn
  amds solve pwn newnote
  amds guide pwn newnote
  amds audit audit_target
  amds audit x402 audit_target
  amds fetch https://www.nssctf.cn/problem/131
  amds exec https://www.nssctf.cn/problem/131
  amds exec --workflow pwn https://www.nssctf.cn/problem/131
  amds learn newnote
  amds --workflow pwn newnote
  amds --web web_chal
  amds --crypto crypto_chal
  amds --misc misc_chal
  amds --reverse rev_chal
  amds -w pwn newnote
  amds pwn newnote
  amds guide pwn defcon/newnote
  amds pwn challenges/newnote
  amds pwn challenges/defcon/newnote
  amds pwn Amadeus/challenges/newnote
  amds --workflow pwn newnote --append "远程地址是 http://node4.anna.nssctf.cn:21280/"
  amds guide --workflow pwn newnote
  amds --workflow pwn newnote --dry-run
  amds --policy aggressive --workflow pwn newnote -- --search
  amds --workflow pwn newnote -- --search -m gpt-5.5
  amds --runner claude audit audit_target -- --model sonnet
  amds newnote

behavior:
  - solve/guide/pre/audit/learn targets are always resolved under ./challenges/
  - target x402_research/x402 means ./challenges/x402_research/x402
  - solve mode reads prompts/cmds/solve.md, then the --workflow prompt under prompts/skills/
  - guide mode reads prompts/cmds/guide.md, then the --workflow prompt under prompts/skills/
  - pre mode reads prompts/cmds/pre.md and stops after environment setup, basic facts, and initial ideas
  - audit mode reads prompts/cmds/audit.md, then the --workflow prompt under prompts/skills/
  - grouped challenges can live under ./challenges/<group>/<challenge>
  - fetch mode accepts a challenge URL and generates a fetch-only prompt
  - exec mode runs fetch first, then solve on the fetched challenge
  - learn mode runs the post-solve learning/reflection workflow for a challenge
  - exec mode accepts --workflow to force the solve workflow after fetch
  - CTF category is selected by --workflow, defaulting to pwn for solve mode and x402 for audit mode
  - checkpoint rules are appended from prompts/cmds/checkpoint.md
  - policy defaults to strict; --policy aggressive permits external writeup/exploit search with source tracking
  - supports workflow shortcuts: --pwn, --web, --crypto, --misc, --reverse, --x402
  - launches Codex by default, or Claude when --runner claude is set
  - compatible with macOS /bin/bash 3.2 and Linux bash; no GNU realpath/mapfile required
EOF
}

die() {
    echo "amds: $*" >&2
    exit 1
}

detect_platform() {
    case "$(uname -s 2>/dev/null || printf 'unknown')" in
        Darwin) printf '%s\n' macos ;;
        Linux) printf '%s\n' linux ;;
        *) printf '%s\n' unknown ;;
    esac
}

normalize_path() {
    local path="$1"
    local prefix=""
    local rest=""
    local part=""
    local old_ifs=""
    local -a parts=()

    case "$path" in
        /*)
            prefix="/"
            rest="${path#/}"
            ;;
        *)
            prefix="$(pwd -P)"
            rest="$path"
            ;;
    esac

    old_ifs="$IFS"
    IFS='/'
    for part in $rest; do
        case "$part" in
            ""|.)
                ;;
            ..)
                if [ ${#parts[@]} -gt 0 ]; then
                    unset "parts[$((${#parts[@]} - 1))]"
                elif [ "$prefix" != "/" ]; then
                    prefix="$(dirname "$prefix")"
                fi
                ;;
            *)
                parts+=("$part")
                ;;
        esac
    done
    IFS="$old_ifs"

    if [ "$prefix" = "/" ]; then
        printf '/%s\n' "$(IFS=/; printf '%s' "${parts[*]}")"
    elif [ ${#parts[@]} -gt 0 ]; then
        printf '%s/%s\n' "$prefix" "$(IFS=/; printf '%s' "${parts[*]}")"
    else
        printf '%s\n' "$prefix"
    fi
}

join_prompt() {
    if [ -z "${prompt:-}" ]; then
        prompt="$1"
    else
        prompt="${prompt}"$'\n\n'"$1"
    fi
}

append_prompt_line() {
    prompt="${prompt}"$'\n'"$1"
}

resolve_challenge() {
    local input="$1"
    local candidate=""

    case "$input" in
        /*)
            candidate="$input"
            ;;
        "${root_name}/challenges/"*)
            candidate="${workspace_parent}/${input}"
            ;;
        challenges/*)
            candidate="${root_dir}/${input}"
            ;;
        *)
            candidate="${root_dir}/challenges/${input}"
            ;;
    esac

    candidate="$(normalize_path "$candidate")"
    [ -n "$candidate" ] || die "challenge directory not found: $input"

    if [[ "$candidate" != "${root_dir}/challenges/"* ]]; then
        die "challenge must live under ${root_dir}/challenges: $input"
    fi

    if [ -e "$candidate" ] && [ ! -d "$candidate" ]; then
        die "challenge path exists but is not a directory: $input"
    fi

    printf '%s\n' "$candidate"
}

render_template() {
    local template_path="$1"
    local challenge_path="$2"
    local target_url="${3:-}"
    local session_id="${4:-}"
    local session_path="${5:-}"
    local output
    local escaped_challenge_path
    local escaped_prompt_root
    local escaped_target_url
    local escaped_session_id
    local escaped_session_path
    local escaped_challenge_group
    local escaped_challenge_group_prefix
    local escaped_group_option
    local escaped_workflow

    [ -f "$template_path" ] || die "workflow template not found: $template_path"
    escaped_challenge_path="$(escape_sed_replacement "$challenge_path")"
    escaped_prompt_root="$(escape_sed_replacement "$prompt_root")"
    escaped_target_url="$(escape_sed_replacement "$target_url")"
    escaped_session_id="$(escape_sed_replacement "$session_id")"
    escaped_session_path="$(escape_sed_replacement "$session_path")"
    escaped_challenge_group="$(escape_sed_replacement "$challenge_group")"
    escaped_challenge_group_prefix="$(escape_sed_replacement "$challenge_group_prefix")"
    escaped_group_option="$(escape_sed_replacement "$group_option")"
    escaped_workflow="$(escape_sed_replacement "$workflow")"
    output="$(sed \
        -e "s|{{challenge_path}}|${escaped_challenge_path}|g" \
        -e "s|{{root_name}}|${escaped_prompt_root}|g" \
        -e "s|{{workflow}}|${escaped_workflow}|g" \
        -e "s|{{target_url}}|${escaped_target_url}|g" \
        -e "s|{{session}}|${escaped_session_id}|g" \
        -e "s|{{session_path}}|${escaped_session_path}|g" \
        -e "s|{{challenge_group}}|${escaped_challenge_group}|g" \
        -e "s|{{challenge_group_prefix}}|${escaped_challenge_group_prefix}|g" \
        -e "s|{{group_option}}|${escaped_group_option}|g" \
        "$template_path")"
    printf '%s\n' "$output"
}

escape_sed_replacement() {
    printf '%s' "$1" | sed -e 's/[\/&|]/\\&/g'
}

resolve_template() {
    local name="$1"
    local candidate

    for candidate in \
        "${prompt_cmd_dir}/${name}.md" \
        "${prompt_skill_dir}/${name}.md" \
        "${prompt_dir}/${name}.md" \
        "${legacy_prompt_dir}/${name}.md" \
        "${legacy_prompt_dir}/${name}.txt"
    do
        if [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    die "workflow template not found for: $name"
}

template_exists() {
    local name="$1"
    [ -f "${prompt_cmd_dir}/${name}.md" ] || \
        [ -f "${prompt_skill_dir}/${name}.md" ] || \
        [ -f "${prompt_dir}/${name}.md" ] || \
        [ -f "${legacy_prompt_dir}/${name}.md" ] || \
        [ -f "${legacy_prompt_dir}/${name}.txt" ]
}

shell_quote() {
    printf '%q' "$1"
}

find_fetched_challenge() {
    local source_url="$1"
    local file
    while IFS= read -r file; do
        if grep -Fq "Source: ${source_url}" "$file" 2>/dev/null || \
           grep -Fq "source: ${source_url}" "$file" 2>/dev/null; then
            case "$file" in
                */amds_state/cognition.json)
                    dirname "$(dirname "$file")"
                    ;;
                *)
                    dirname "$file"
                    ;;
            esac
            return 0
        fi
    done < <(find "${root_dir}/challenges" -mindepth 2 -type f \( -name description.md -o -path '*/amds_state/cognition.json' -o -name cognition.json \) | sort)

    return 1
}

infer_workflow_from_challenge() {
    local challenge_dir="$1"
    local category=""

    if [ -f "${challenge_dir}/description.md" ]; then
        category="$(sed -n 's/^- Category:[[:space:]]*//p' "${challenge_dir}/description.md" | head -n 1)"
    fi
    local cognition_file="${challenge_dir}/amds_state/cognition.json"
    if [ ! -f "$cognition_file" ] && [ -f "${challenge_dir}/cognition.json" ]; then
        cognition_file="${challenge_dir}/cognition.json"
    fi
    if [ -z "$category" ] && [ -f "$cognition_file" ]; then
        category="$(python3 -c 'import json,sys; root=json.load(open(sys.argv[1])); meta=root.get("metadata",{}); facts=root.get("facts",{}); print(meta.get("challenge_type") or next((str(item).split(":",1)[1].strip() for section in facts.get("sections",[]) for item in section.get("items",[]) if str(item).lower().startswith("category:")), ""))' "$cognition_file" 2>/dev/null || true)"
    fi

    case "$(printf '%s' "${category:-}" | tr '[:upper:]' '[:lower:]')" in
        pwn*) printf '%s\n' pwn ;;
        web*) printf '%s\n' web ;;
        crypto*) printf '%s\n' crypto ;;
        misc*) printf '%s\n' misc ;;
        reverse*) printf '%s\n' reverse ;;
        x402*) printf '%s\n' x402 ;;
        *) printf '%s\n' pwn ;;
    esac
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "${script_dir}/.." && pwd)"
workspace_parent="$(cd "${root_dir}/.." && pwd)"
root_name="$(basename "${root_dir}")"
workspace_dir="$root_dir"
platform="$(detect_platform)"
prompt_root="."
prompt_dir="${root_dir}/prompts"
prompt_cmd_dir="${prompt_dir}/cmds"
prompt_skill_dir="${prompt_dir}/skills"
legacy_prompt_dir="${root_dir}/pts"

print_prompt=0
dry_run=0
runner="${AMDS_RUNNER:-codex}"
policy="${AMDS_POLICY:-strict}"
mode="solve"
display_mode="solve"
workflow="pwn"
workflow_explicit=0
challenge_group=""
target_input=""
session_input=""
declare -a append_lines=()
declare -a agent_args=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -p|--print)
            print_prompt=1
            shift
            ;;
        -n|--dry-run)
            dry_run=1
            shift
            ;;
        --runner)
            [ $# -ge 2 ] || die "--runner requires codex or claude"
            case "$2" in
                codex|claude)
                    runner="$2"
                    ;;
                *)
                    die "unknown runner: $2"
                    ;;
            esac
            shift 2
            ;;
        --policy)
            [ $# -ge 2 ] || die "--policy requires strict, aggressive, or none"
            case "$2" in
                strict|default)
                    policy="strict"
                    ;;
                aggressive)
                    policy="aggressive"
                    ;;
                none|off)
                    policy="none"
                    ;;
                *)
                    die "unknown policy: $2"
                    ;;
            esac
            shift 2
            ;;
        --codex)
            runner="codex"
            shift
            ;;
        --claude)
            runner="claude"
            shift
            ;;
        -w|--workflow)
            [ $# -ge 2 ] || die "--workflow requires a name"
            workflow="$2"
            workflow_explicit=1
            shift 2
            ;;
        --group)
            [ $# -ge 2 ] || die "--group requires a name"
            challenge_group="$2"
            shift 2
            ;;
        --mode|-m)
            [ $# -ge 2 ] || die "--mode requires solve, guide, pre, audit, fetch, exec, or learn"
            case "$2" in
                solve|fetch|exec)
                    mode="$2"
                    display_mode="$2"
                    ;;
                pre)
                    mode="pre"
                    display_mode="pre"
                    ;;
                audit)
                    mode="audit"
                    display_mode="audit"
                    if [ "$workflow_explicit" = "0" ]; then
                        workflow="x402"
                    fi
                    ;;
                guide)
                    mode="solve"
                    display_mode="guide"
                    ;;
                learn)
                    mode="solve"
                    display_mode="learn"
                    workflow="learn"
                    workflow_explicit=1
                    ;;
                *)
                    die "unknown mode: $2"
                    ;;
            esac
            shift 2
            ;;
        --pwn|--web|--crypto|--misc|--reverse|--x402)
            workflow="${1#--}"
            workflow_explicit=1
            shift
            ;;
        --append)
            [ $# -ge 2 ] || die "--append requires text"
            append_lines+=("$2")
            shift 2
            ;;
        --session)
            [ $# -ge 2 ] || die "--session requires an id or latest"
            session_input="$2"
            shift 2
            ;;
        --)
            shift
            agent_args=("$@")
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            if [ -z "$target_input" ] && [ "$workflow_explicit" = "0" ]; then
                case "$1" in
                    solve|fetch|exec)
                        mode="$1"
                        display_mode="$1"
                        shift
                        continue
                        ;;
                    pre)
                        mode="pre"
                        display_mode="pre"
                        shift
                        continue
                        ;;
                    audit)
                        mode="audit"
                        display_mode="audit"
                        workflow="x402"
                        shift
                        continue
                        ;;
                    guide)
                        mode="solve"
                        display_mode="guide"
                        shift
                        continue
                        ;;
                    learn)
                        mode="solve"
                        display_mode="learn"
                        workflow="learn"
                        workflow_explicit=1
                        shift
                        continue
                        ;;
                esac
            fi

            if { [ "$mode" = "solve" ] || [ "$mode" = "pre" ]; } && [ -z "$target_input" ] && [ "$workflow_explicit" = "0" ] && [ "$workflow" = "pwn" ] && template_exists "$1"; then
                workflow="$1"
                shift
                continue
            fi

            if [ "$mode" = "audit" ] && [ -z "$target_input" ] && [ "$workflow_explicit" = "0" ] && [ "$workflow" = "x402" ] && template_exists "$1"; then
                workflow="$1"
                shift
                continue
            fi

            if [ -n "$target_input" ]; then
                die "unexpected extra argument: $1"
            fi
            target_input="$1"
            shift
            ;;
    esac
done

[ -n "$target_input" ] || die "target is required"

case "$runner" in
    codex|claude) ;;
    *) die "unknown runner: $runner" ;;
esac

group_option=""
challenge_group_prefix=""
if [ -n "$challenge_group" ]; then
    group_option="--group $(shell_quote "$challenge_group") "
    challenge_group_prefix="${challenge_group%/}/"
fi

challenge_prompt_path=""
target_url=""
session_prompt_value=""
session_prompt_path=""

case "$mode" in
    solve|audit|pre)
        if [ -n "$challenge_group" ]; then
            case "$target_input" in
                /*|challenges/*|"${root_name}/challenges/"*|*/*)
                    die "--group with solve/guide/pre/audit requires a bare challenge name, not a path: $target_input"
                    ;;
                *)
                    target_input="${challenge_group}/${target_input}"
                    ;;
            esac
        fi
        challenge_dir="$(resolve_challenge "$target_input")"
        challenge_rel="${challenge_dir#${root_dir}/}"
        challenge_prompt_path="${challenge_rel}"
        if [ "$mode" = "pre" ]; then
            template_path="$(resolve_template "pre")"
        else
            template_path="$(resolve_template "$workflow")"
        fi
        if [ -n "$session_input" ]; then
            if [ "$display_mode" != "learn" ]; then
                die "--session is only supported with learn mode"
            fi
            case "$session_input" in
                /*|*/*|.|..)
                    die "--session must be a session id or latest, not a path: $session_input"
                    ;;
            esac
            session_prompt_value="$session_input"
            session_prompt_path="${challenge_prompt_path}/amds_state/sessions/${session_input}"
        fi
        ;;
    fetch)
        target_url="$target_input"
        workflow="fetch"
        template_path="$(resolve_template "$workflow")"
        ;;
    exec)
        target_url="$target_input"
        fetch_cmd=("$0" --mode fetch "$target_url")
        fetch_cmd+=(--runner "$runner")
        fetch_cmd+=(--policy "$policy")
        if [ -n "$challenge_group" ]; then
            fetch_cmd+=(--group "$challenge_group")
        fi
        if [ ${#agent_args[@]} -gt 0 ]; then
            fetch_cmd+=("--" "${agent_args[@]}")
        fi

        if [ "$dry_run" = "1" ] || [ "$print_prompt" = "1" ]; then
            if [ "$workflow_explicit" = "1" ]; then
                dry_solve_workflow="$workflow"
            else
                dry_solve_workflow="auto"
            fi

            printf 'workspace: %s\n' "$workspace_dir"
            printf 'mode: exec\n'
            printf 'policy: %s\n' "$policy"
            printf 'url: %s\n' "$target_url"
            if [ -n "$challenge_group" ]; then
                printf 'group: %s\n' "$challenge_group"
            fi
            printf 'solve_workflow: %s\n' "$dry_solve_workflow"
            printf 'fetch_command:'
            for arg in "${fetch_cmd[@]}"; do
                printf ' %q' "$arg"
            done
            printf '\n'

            existing_challenge_dir="$(find_fetched_challenge "$target_url" || true)"
            if [ -n "$existing_challenge_dir" ]; then
                if [ "$workflow_explicit" = "1" ]; then
                    dry_solve_workflow="$workflow"
                else
                    dry_solve_workflow="$(infer_workflow_from_challenge "$existing_challenge_dir")"
                fi
                dry_solve_cmd=("$0" --mode solve --workflow "$dry_solve_workflow" --runner "$runner" --policy "$policy")
                if [ ${#append_lines[@]} -gt 0 ]; then
                    for line in "${append_lines[@]}"; do
                        dry_solve_cmd+=(--append "$line")
                    done
                fi
                dry_solve_cmd+=("$existing_challenge_dir")
                if [ ${#agent_args[@]} -gt 0 ]; then
                    dry_solve_cmd+=("--" "${agent_args[@]}")
                fi
                printf 'solve_command:'
                for arg in "${dry_solve_cmd[@]}"; do
                    printf ' %q' "$arg"
                done
                printf '\n'
            else
                if [ "$workflow_explicit" = "1" ]; then
                    printf 'solve_command: resolved after fetch by matching source URL under %s/challenges, then %q --mode solve --workflow %q --runner %q --policy %q <challenge_dir>\n' "$prompt_root" "$0" "$workflow" "$runner" "$policy"
                else
                    printf 'solve_command: resolved after fetch by matching source URL under %s/challenges, then infer workflow from description.md/amds_state/cognition.json\n' "$prompt_root"
                fi
            fi
            exit 0
        fi

        "${fetch_cmd[@]}"

        challenge_dir="$(find_fetched_challenge "$target_url")" || die "fetched challenge not found for: $target_url"
        if [ "$workflow_explicit" = "1" ]; then
            solve_workflow="$workflow"
        else
            solve_workflow="$(infer_workflow_from_challenge "$challenge_dir")"
        fi

        solve_cmd=("$0" --mode solve --workflow "$solve_workflow" --runner "$runner" --policy "$policy")
        if [ ${#append_lines[@]} -gt 0 ]; then
            for line in "${append_lines[@]}"; do
                solve_cmd+=(--append "$line")
            done
        fi
        solve_cmd+=("$challenge_dir")
        if [ ${#agent_args[@]} -gt 0 ]; then
            solve_cmd+=("--" "${agent_args[@]}")
        fi

        exec "${solve_cmd[@]}"
        ;;
esac

if [ "$mode" = "exec" ]; then
    exit 0
fi

policy_template_path=""
case "$policy" in
    strict) policy_template_path="$(resolve_template "policy")" ;;
    aggressive) policy_template_path="$(resolve_template "policy_aggressive")" ;;
    none) ;;
    *) die "unknown policy: $policy" ;;
esac

if [ "$mode" = "pre" ]; then
    state_docs_template_path="$(resolve_template "state_docs")"
    capabilities_template_path="$(resolve_template "capabilities")"
    checkpoint_template_path="$(resolve_template "checkpoint")"
    prompt=""
    join_prompt "$(render_template "$template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$state_docs_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$capabilities_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$checkpoint_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
elif { [ "$mode" = "solve" ] || [ "$mode" = "audit" ]; } && [ "$display_mode" != "learn" ]; then
    entry_template_path="$(resolve_template "$display_mode")"
    state_docs_template_path="$(resolve_template "state_docs")"
    capabilities_template_path="$(resolve_template "capabilities")"
    checkpoint_template_path="$(resolve_template "checkpoint")"
    prompt=""
    join_prompt "$(render_template "$entry_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$state_docs_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$capabilities_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
    join_prompt "$(render_template "$checkpoint_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
else
    prompt=""
    join_prompt "$(render_template "$template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
fi

if [ ${#append_lines[@]} -gt 0 ]; then
    for line in "${append_lines[@]}"; do
        append_prompt_line "$line"
    done
fi

if [ -n "$policy_template_path" ]; then
    join_prompt "$(render_template "$policy_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")"
fi

if [ "$print_prompt" = "1" ] && [ "$dry_run" = "0" ]; then
    printf '%s\n' "$prompt"
    exit 0
fi

case "$runner" in
    codex)
        agent_bin="${CODEX_BIN:-codex}"
        command -v "$agent_bin" >/dev/null 2>&1 || die "codex not found: $agent_bin"
        agent_cmd=(
            "$agent_bin"
            --dangerously-bypass-approvals-and-sandbox
            -C "$workspace_dir"
        )
        ;;
    claude)
        agent_bin="${CLAUDE_BIN:-claude}"
        command -v "$agent_bin" >/dev/null 2>&1 || die "claude not found: $agent_bin"
        agent_cmd=(
            "$agent_bin"
            --dangerously-skip-permissions
        )
        ;;
esac

if [ ${#agent_args[@]} -gt 0 ]; then
    agent_cmd+=("${agent_args[@]}")
fi

agent_cmd+=("$prompt")

if [ "$dry_run" = "1" ]; then
    printf 'workspace: %s\n' "$workspace_dir"
    printf 'platform: %s\n' "$platform"
    printf 'runner: %s\n' "$runner"
    printf 'mode: %s\n' "$display_mode"
    printf 'workflow: %s\n' "$workflow"
    if [ "$display_mode" = "guide" ]; then
        printf 'guided: 1\n'
    else
        printf 'guided: 0\n'
    fi
    if [ "$mode" = "solve" ] || [ "$mode" = "audit" ] || [ "$mode" = "pre" ]; then
        printf 'challenge: %s\n' "$challenge_prompt_path"
        if [ -n "$challenge_group" ]; then
            printf 'group: %s\n' "$challenge_group"
        fi
        if [ -n "$session_prompt_value" ]; then
            printf 'session: %s\n' "$session_prompt_value"
            printf 'session_path: %s\n' "$session_prompt_path"
        fi
    else
        printf 'url: %s\n' "$target_url"
        if [ -n "$challenge_group" ]; then
            printf 'group: %s\n' "$challenge_group"
        fi
    fi
    printf 'command:'
    for arg in "${agent_cmd[@]}"; do
        printf ' %q' "$arg"
    done
    printf '\n\nprompt:\n%s\n' "$prompt"
    exit 0
fi

if [ "$runner" = "claude" ]; then
    cd "$workspace_dir"
fi

exec "${agent_cmd[@]}"
