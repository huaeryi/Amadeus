#!/usr/bin/env bash
set -euo pipefail

usage() {
    cat <<'EOF'
usage: amds [--print] [--dry-run] [--group NAME] [--append TEXT] [--mode solve|guide|fetch|exec|learn] [--workflow NAME|--pwn|--web|--crypto|--misc|--reverse|--x402] [--session ID|latest] <challenge|path|url> [-- codex_args...]

examples:
  amds --mode solve --workflow pwn newnote
  amds --mode guide --workflow pwn newnote
  amds --mode fetch https://www.nssctf.cn/problem/131
  amds fetch --group defcon https://www.nssctf.cn/problem/131
  amds --mode exec https://www.nssctf.cn/problem/131
  amds --mode exec --workflow pwn https://www.nssctf.cn/problem/131
  amds --mode learn newnote
  amds learn newnote --session latest
  amds learn newnote --session 20260522-143012-pwn
  amds solve pwn newnote
  amds guide pwn newnote
  amds fetch https://www.nssctf.cn/problem/131
  amds exec https://www.nssctf.cn/problem/131
  amds exec --workflow pwn https://www.nssctf.cn/problem/131
  amds learn newnote
  amds --workflow pwn newnote
  amds --web web_chal
  amds --crypto crypto_chal
  amds --misc misc_chal
  amds --reverse rev_chal
  amds --workflow x402 audit_target
  amds -w pwn newnote
  amds pwn newnote
  amds guide pwn defcon/newnote
  amds pwn challenges/newnote
  amds pwn challenges/defcon/newnote
  amds pwn Amadeus/challenges/newnote
  amds --workflow pwn newnote --append "远程地址是 http://node4.anna.nssctf.cn:21280/"
  amds guide --workflow pwn newnote
  amds --workflow pwn newnote --dry-run
  amds --workflow pwn newnote -- --search -m gpt-5.5
  amds newnote

behavior:
  - solve mode resolves the challenge under ./challenges/, including grouped paths like defcon/newnote
  - solve mode reads prompts/cmds/solve.md, then the --workflow prompt under prompts/skills/
  - guide mode reads prompts/cmds/guide.md, then the --workflow prompt under prompts/skills/
  - grouped challenges can live under ./challenges/<group>/<challenge>
  - fetch mode accepts a challenge URL and generates a fetch-only prompt
  - exec mode runs fetch first, then solve on the fetched challenge
  - learn mode runs the post-solve learning/reflection workflow for a challenge
  - exec mode accepts --workflow to force the solve workflow after fetch
  - CTF category is selected by --workflow, defaulting to pwn for solve mode
  - checkpoint rules are appended from prompts/cmds/checkpoint.md
  - supports workflow shortcuts: --pwn, --web, --crypto, --misc, --reverse, --x402
  - launches codex with the current CLI equivalent of "codex --yolo"
EOF
}

die() {
    echo "amds: $*" >&2
    exit 1
}

resolve_challenge() {
    local input="$1"
    local candidate=""

    case "$input" in
        /*)
            candidate="$input"
            ;;
        "${root_name}/challenges/"*)
            candidate="${workspace_parent}/${input}"
            ;;
        challenges/*)
            candidate="${root_dir}/${input}"
            ;;
        *)
            candidate="${root_dir}/challenges/${input}"
            ;;
    esac

    candidate="$(realpath -m "$candidate" 2>/dev/null || true)"
    [ -n "$candidate" ] || die "challenge directory not found: $input"

    if [[ "$candidate" != "${root_dir}/challenges/"* ]]; then
        die "challenge must live under ${root_dir}/challenges: $input"
    fi

    if [ -e "$candidate" ] && [ ! -d "$candidate" ]; then
        die "challenge path exists but is not a directory: $input"
    fi

    printf '%s\n' "$candidate"
}

render_template() {
    local template_path="$1"
    local challenge_path="$2"
    local target_url="${3:-}"
    local session_id="${4:-}"
    local session_path="${5:-}"
    local output
    local escaped_challenge_path
    local escaped_prompt_root
    local escaped_target_url
    local escaped_session_id
    local escaped_session_path
    local escaped_challenge_group
    local escaped_challenge_group_prefix
    local escaped_group_option
    local escaped_workflow

    [ -f "$template_path" ] || die "workflow template not found: $template_path"
    escaped_challenge_path="$(escape_sed_replacement "$challenge_path")"
    escaped_prompt_root="$(escape_sed_replacement "$prompt_root")"
    escaped_target_url="$(escape_sed_replacement "$target_url")"
    escaped_session_id="$(escape_sed_replacement "$session_id")"
    escaped_session_path="$(escape_sed_replacement "$session_path")"
    escaped_challenge_group="$(escape_sed_replacement "$challenge_group")"
    escaped_challenge_group_prefix="$(escape_sed_replacement "$challenge_group_prefix")"
    escaped_group_option="$(escape_sed_replacement "$group_option")"
    escaped_workflow="$(escape_sed_replacement "$workflow")"
    output="$(sed \
        -e "s|{{challenge_path}}|${escaped_challenge_path}|g" \
        -e "s|{{root_name}}|${escaped_prompt_root}|g" \
        -e "s|{{workflow}}|${escaped_workflow}|g" \
        -e "s|{{target_url}}|${escaped_target_url}|g" \
        -e "s|{{session}}|${escaped_session_id}|g" \
        -e "s|{{session_path}}|${escaped_session_path}|g" \
        -e "s|{{challenge_group}}|${escaped_challenge_group}|g" \
        -e "s|{{challenge_group_prefix}}|${escaped_challenge_group_prefix}|g" \
        -e "s|{{group_option}}|${escaped_group_option}|g" \
        "$template_path")"
    printf '%s\n' "$output"
}

escape_sed_replacement() {
    printf '%s' "$1" | sed -e 's/[\/&|]/\\&/g'
}

resolve_template() {
    local name="$1"
    local candidate

    for candidate in \
        "${prompt_cmd_dir}/${name}.md" \
        "${prompt_skill_dir}/${name}.md" \
        "${prompt_dir}/${name}.md" \
        "${legacy_prompt_dir}/${name}.md" \
        "${legacy_prompt_dir}/${name}.txt"
    do
        if [ -f "$candidate" ]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done

    die "workflow template not found for: $name"
}

template_exists() {
    local name="$1"
    [ -f "${prompt_cmd_dir}/${name}.md" ] || \
        [ -f "${prompt_skill_dir}/${name}.md" ] || \
        [ -f "${prompt_dir}/${name}.md" ] || \
        [ -f "${legacy_prompt_dir}/${name}.md" ] || \
        [ -f "${legacy_prompt_dir}/${name}.txt" ]
}

shell_quote() {
    printf '%q' "$1"
}

find_fetched_challenge() {
    local source_url="$1"
    local file
    while IFS= read -r file; do
        if grep -Fq "Source: ${source_url}" "$file" 2>/dev/null || \
           grep -Fq "source: ${source_url}" "$file" 2>/dev/null; then
            dirname "$file"
            return 0
        fi
    done < <(find "${root_dir}/challenges" -mindepth 2 -type f \( -name description.md -o -name cognition.json \) | sort)

    return 1
}

infer_workflow_from_challenge() {
    local challenge_dir="$1"
    local category=""

    if [ -f "${challenge_dir}/description.md" ]; then
        category="$(sed -n 's/^- Category:[[:space:]]*//p' "${challenge_dir}/description.md" | head -n 1)"
    fi
    if [ -z "$category" ] && [ -f "${challenge_dir}/cognition.json" ]; then
        category="$(python3 -c 'import json,sys; root=json.load(open(sys.argv[1])); meta=root.get("metadata",{}); facts=root.get("facts",{}); print(meta.get("challenge_type") or next((str(item).split(":",1)[1].strip() for section in facts.get("sections",[]) for item in section.get("items",[]) if str(item).lower().startswith("category:")), ""))' "${challenge_dir}/cognition.json" 2>/dev/null || true)"
    fi

    case "$(printf '%s' "${category:-}" | tr '[:upper:]' '[:lower:]')" in
        pwn*) printf '%s\n' pwn ;;
        web*) printf '%s\n' web ;;
        crypto*) printf '%s\n' crypto ;;
        misc*) printf '%s\n' misc ;;
        reverse*) printf '%s\n' reverse ;;
        x402*) printf '%s\n' x402 ;;
        *) printf '%s\n' pwn ;;
    esac
}

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
root_dir="$(cd "${script_dir}/.." && pwd)"
workspace_parent="$(cd "${root_dir}/.." && pwd)"
root_name="$(basename "${root_dir}")"
workspace_dir="$root_dir"
prompt_root="."
prompt_dir="${root_dir}/prompts"
prompt_cmd_dir="${prompt_dir}/cmds"
prompt_skill_dir="${prompt_dir}/skills"
legacy_prompt_dir="${root_dir}/pts"

print_prompt=0
dry_run=0
mode="solve"
display_mode="solve"
workflow="pwn"
workflow_explicit=0
challenge_group=""
target_input=""
session_input=""
declare -a append_lines=()
declare -a codex_args=()

while [ $# -gt 0 ]; do
    case "$1" in
        -h|--help)
            usage
            exit 0
            ;;
        -p|--print)
            print_prompt=1
            shift
            ;;
        -n|--dry-run)
            dry_run=1
            shift
            ;;
        -w|--workflow)
            [ $# -ge 2 ] || die "--workflow requires a name"
            workflow="$2"
            workflow_explicit=1
            shift 2
            ;;
        --group)
            [ $# -ge 2 ] || die "--group requires a name"
            challenge_group="$2"
            shift 2
            ;;
        --mode|-m)
            [ $# -ge 2 ] || die "--mode requires solve, guide, fetch, exec, or learn"
            case "$2" in
                solve|fetch|exec)
                    mode="$2"
                    display_mode="$2"
                    ;;
                guide)
                    mode="solve"
                    display_mode="guide"
                    ;;
                learn)
                    mode="solve"
                    display_mode="learn"
                    workflow="learn"
                    workflow_explicit=1
                    ;;
                *)
                    die "unknown mode: $2"
                    ;;
            esac
            shift 2
            ;;
        --pwn|--web|--crypto|--misc|--reverse|--x402)
            workflow="${1#--}"
            workflow_explicit=1
            shift
            ;;
        --append)
            [ $# -ge 2 ] || die "--append requires text"
            append_lines+=("$2")
            shift 2
            ;;
        --session)
            [ $# -ge 2 ] || die "--session requires an id or latest"
            session_input="$2"
            shift 2
            ;;
        --)
            shift
            codex_args=("$@")
            break
            ;;
        -*)
            die "unknown option: $1"
            ;;
        *)
            if [ -z "$target_input" ] && [ "$workflow_explicit" = "0" ]; then
                case "$1" in
                    solve|fetch|exec)
                        mode="$1"
                        display_mode="$1"
                        shift
                        continue
                        ;;
                    guide)
                        mode="solve"
                        display_mode="guide"
                        shift
                        continue
                        ;;
                    learn)
                        mode="solve"
                        display_mode="learn"
                        workflow="learn"
                        workflow_explicit=1
                        shift
                        continue
                        ;;
                esac
            fi

            if [ "$mode" = "solve" ] && [ -z "$target_input" ] && [ "$workflow_explicit" = "0" ] && [ "$workflow" = "pwn" ] && template_exists "$1"; then
                workflow="$1"
                shift
                continue
            fi

            if [ -n "$target_input" ]; then
                die "unexpected extra argument: $1"
            fi
            target_input="$1"
            shift
            ;;
    esac
done

[ -n "$target_input" ] || die "target is required"

group_option=""
challenge_group_prefix=""
if [ -n "$challenge_group" ]; then
    group_option="--group $(shell_quote "$challenge_group") "
    challenge_group_prefix="${challenge_group%/}/"
fi

challenge_prompt_path=""
target_url=""
session_prompt_value=""
session_prompt_path=""

case "$mode" in
    solve)
        if [ -n "$challenge_group" ]; then
            case "$target_input" in
                /*|challenges/*|"${root_name}/challenges/"*|*/*)
                    die "--group with solve/guide requires a bare challenge name, not a path: $target_input"
                    ;;
                *)
                    target_input="${challenge_group}/${target_input}"
                    ;;
            esac
        fi
        challenge_dir="$(resolve_challenge "$target_input")"
        challenge_rel="${challenge_dir#${root_dir}/}"
        challenge_prompt_path="${challenge_rel}"
        template_path="$(resolve_template "$workflow")"
        if [ -n "$session_input" ]; then
            if [ "$display_mode" != "learn" ]; then
                die "--session is only supported with learn mode"
            fi
            case "$session_input" in
                /*|*/*|.|..)
                    die "--session must be a session id or latest, not a path: $session_input"
                    ;;
            esac
            session_prompt_value="$session_input"
            session_prompt_path="${challenge_prompt_path}/.amadeus/sessions/${session_input}"
        fi
        ;;
    fetch)
        target_url="$target_input"
        workflow="fetch"
        template_path="$(resolve_template "$workflow")"
        ;;
    exec)
        target_url="$target_input"
        fetch_cmd=("$0" --mode fetch "$target_url")
        if [ -n "$challenge_group" ]; then
            fetch_cmd+=(--group "$challenge_group")
        fi
        if [ ${#codex_args[@]} -gt 0 ]; then
            fetch_cmd+=("--" "${codex_args[@]}")
        fi

        if [ "$dry_run" = "1" ] || [ "$print_prompt" = "1" ]; then
            if [ "$workflow_explicit" = "1" ]; then
                dry_solve_workflow="$workflow"
            else
                dry_solve_workflow="auto"
            fi

            printf 'workspace: %s\n' "$workspace_dir"
            printf 'mode: exec\n'
            printf 'url: %s\n' "$target_url"
            if [ -n "$challenge_group" ]; then
                printf 'group: %s\n' "$challenge_group"
            fi
            printf 'solve_workflow: %s\n' "$dry_solve_workflow"
            printf 'fetch_command:'
            for arg in "${fetch_cmd[@]}"; do
                printf ' %q' "$arg"
            done
            printf '\n'

            existing_challenge_dir="$(find_fetched_challenge "$target_url" || true)"
            if [ -n "$existing_challenge_dir" ]; then
                if [ "$workflow_explicit" = "1" ]; then
                    dry_solve_workflow="$workflow"
                else
                    dry_solve_workflow="$(infer_workflow_from_challenge "$existing_challenge_dir")"
                fi
                dry_solve_cmd=("$0" --mode solve --workflow "$dry_solve_workflow")
                if [ ${#append_lines[@]} -gt 0 ]; then
                    for line in "${append_lines[@]}"; do
                        dry_solve_cmd+=(--append "$line")
                    done
                fi
                dry_solve_cmd+=("$existing_challenge_dir")
                if [ ${#codex_args[@]} -gt 0 ]; then
                    dry_solve_cmd+=("--" "${codex_args[@]}")
                fi
                printf 'solve_command:'
                for arg in "${dry_solve_cmd[@]}"; do
                    printf ' %q' "$arg"
                done
                printf '\n'
            else
                if [ "$workflow_explicit" = "1" ]; then
                    printf 'solve_command: resolved after fetch by matching source URL under %s/challenges, then %q --mode solve --workflow %q <challenge_dir>\n' "$prompt_root" "$0" "$workflow"
                else
                    printf 'solve_command: resolved after fetch by matching source URL under %s/challenges, then infer workflow from description.md/cognition.json\n' "$prompt_root"
                fi
            fi
            exit 0
        fi

        "${fetch_cmd[@]}"

        challenge_dir="$(find_fetched_challenge "$target_url")" || die "fetched challenge not found for: $target_url"
        if [ "$workflow_explicit" = "1" ]; then
            solve_workflow="$workflow"
        else
            solve_workflow="$(infer_workflow_from_challenge "$challenge_dir")"
        fi

        solve_cmd=("$0" --mode solve --workflow "$solve_workflow")
        if [ ${#append_lines[@]} -gt 0 ]; then
            for line in "${append_lines[@]}"; do
                solve_cmd+=(--append "$line")
            done
        fi
        solve_cmd+=("$challenge_dir")
        if [ ${#codex_args[@]} -gt 0 ]; then
            solve_cmd+=("--" "${codex_args[@]}")
        fi

        exec "${solve_cmd[@]}"
        ;;
esac

if [ "$mode" = "exec" ]; then
    exit 0
fi

if [ "$mode" = "solve" ] && [ "$display_mode" != "learn" ]; then
    entry_template_path="$(resolve_template "$display_mode")"
    state_docs_template_path="$(resolve_template "state_docs")"
    capabilities_template_path="$(resolve_template "capabilities")"
    checkpoint_template_path="$(resolve_template "checkpoint")"
    mapfile -t prompt_lines < <(render_template "$entry_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")
    mapfile -t workflow_lines < <(render_template "$template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")
    mapfile -t state_docs_lines < <(render_template "$state_docs_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")
    mapfile -t capabilities_lines < <(render_template "$capabilities_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")
    mapfile -t checkpoint_lines < <(render_template "$checkpoint_template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")
    prompt_lines+=("")
    prompt_lines+=("${workflow_lines[@]}")
    prompt_lines+=("")
    prompt_lines+=("${state_docs_lines[@]}")
    prompt_lines+=("")
    prompt_lines+=("${capabilities_lines[@]}")
    prompt_lines+=("")
    prompt_lines+=("${checkpoint_lines[@]}")
else
    mapfile -t prompt_lines < <(render_template "$template_path" "$challenge_prompt_path" "$target_url" "$session_prompt_value" "$session_prompt_path")
fi

if [ ${#append_lines[@]} -gt 0 ]; then
    prompt_lines+=("${append_lines[@]}")
fi

printf -v prompt '%s\n' "${prompt_lines[@]}"
prompt="${prompt%$'\n'}"

if [ "$print_prompt" = "1" ] && [ "$dry_run" = "0" ]; then
    printf '%s\n' "$prompt"
    exit 0
fi

codex_bin="${CODEX_BIN:-codex}"
command -v "$codex_bin" >/dev/null 2>&1 || die "codex not found: $codex_bin"

codex_cmd=(
    "$codex_bin"
    --dangerously-bypass-approvals-and-sandbox
    -C "$workspace_dir"
)

if [ ${#codex_args[@]} -gt 0 ]; then
    codex_cmd+=("${codex_args[@]}")
fi

codex_cmd+=("$prompt")

if [ "$dry_run" = "1" ]; then
    printf 'workspace: %s\n' "$workspace_dir"
    printf 'mode: %s\n' "$display_mode"
    printf 'workflow: %s\n' "$workflow"
    if [ "$display_mode" = "guide" ]; then
        printf 'guided: 1\n'
    else
        printf 'guided: 0\n'
    fi
    if [ "$mode" = "solve" ]; then
        printf 'challenge: %s\n' "$challenge_prompt_path"
        if [ -n "$challenge_group" ]; then
            printf 'group: %s\n' "$challenge_group"
        fi
        if [ -n "$session_prompt_value" ]; then
            printf 'session: %s\n' "$session_prompt_value"
            printf 'session_path: %s\n' "$session_prompt_path"
        fi
    else
        printf 'url: %s\n' "$target_url"
        if [ -n "$challenge_group" ]; then
            printf 'group: %s\n' "$challenge_group"
        fi
    fi
    printf 'command:'
    for arg in "${codex_cmd[@]}"; do
        printf ' %q' "$arg"
    done
    printf '\n\nprompt:\n%s\n' "$prompt"
    exit 0
fi

exec "${codex_cmd[@]}"
